<UserControl x:Class="mdcheckerwpf.MVVM.View.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="700" Height="600"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>

        <Style TargetType="RadioButton" x:Key="PageOptionStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Dot"
                                    Width="14" Height="14"
                                    CornerRadius="7"
                                    BorderBrush="#AAA"
                                    BorderThickness="2"
                                    Background="Transparent" />
                            <ContentPresenter Margin="6,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="16,16,0,0">

            <TextBlock Text="Общие настройки"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#222"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,16"
                        VerticalAlignment="Center">
                <CheckBox x:Name="chkMainParts"
                          Width="18" Height="18"
                          VerticalAlignment="Center"
                          Checked="CheckBox_CheckedChanged"
                          Unchecked="CheckBox_CheckedChanged"/>
                <TextBlock Text="Проверять на наличие SPD для MainPart"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Стартовая страница"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#444"
                       Margin="0,0,0,8"/>

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <RadioButton x:Name="rbStartMain"
                             Content="Главная"
                             GroupName="StartPage"
                             Style="{StaticResource PageOptionStyle}"
                             Checked="StartPage_Toggled"/>
                <RadioButton x:Name="rbStartModel"
                             Content="Модель"
                             GroupName="StartPage"
                             Style="{StaticResource PageOptionStyle}"
                             Checked="StartPage_Toggled"/>
                <RadioButton x:Name="rbStartDrawings"
                             Content="Чертежи"
                             GroupName="StartPage"
                             Style="{StaticResource PageOptionStyle}"
                             Checked="StartPage_Toggled"/>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Проверки модели -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Проверки модели"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#444"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkLength" Content="Проверка длины деталей" FontSize="14" Margin="0,2"
                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>
                    <CheckBox x:Name="chkMaterial" Content="Проверка материала" FontSize="14" Margin="0,2"
                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>
                    <CheckBox x:Name="chkDetailDrawings" Content="Проверка наличия чертежей для детали" FontSize="14" Margin="0,2"
                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>
                    <CheckBox x:Name="chkBoltLength" Content="Проверка длины болтов" FontSize="14" Margin="0,2"
                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>
                    <CheckBox x:Name="chkScrewAssembly" Content="Проверка на Screw с шайбами и гайками" FontSize="14" Margin="0,2"
                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>
                </StackPanel>

                <!-- Проверки чертежей -->
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="Проверки чертежа"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#444"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkRounding" Content="Проверка округления" FontSize="14" Margin="0,2"
                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>
                    <CheckBox x:Name="chkReflectedView" Content="Проверка на Reflected View" FontSize="14" Margin="0,2"
                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>
                    <CheckBox x:Name="chkDrawnCheckedBy" Content="Проверка на DrawnBy/CheckBy" FontSize="14" Margin="0,2"
                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>
                    <CheckBox x:Name="chkPartMarkMissing" Content="Проверка Assembly Drawing на отсутствие Part Mark" FontSize="14" Margin="0,2"
                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
